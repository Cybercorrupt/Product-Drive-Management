# Product Drive CMS — Apache / cPanel configuration

# Front-controller routing: send everything that isn't a real file/dir to index.php
<IfModule mod_rewrite.c>
    RewriteEngine On
    # If you deploy in a subfolder, set: RewriteBase /subfolder/
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [QSA,L]
</IfModule>

# Default document
DirectoryIndex index.php

# Protect sensitive files
<FilesMatch "(^\.env|\.env\..*|\.sql|composer\.(json|lock)|\.gitignore)$">
    Require all denied
</FilesMatch>

# Block access to config, sql, scripts and includes directories
RedirectMatch 403 ^/(config|sql|includes|controllers|docs)/.*\.(php|sql|md)$

# Prevent directory listing
Options -Indexes

# Disable script execution inside uploads
<IfModule mod_php.c>
    php_admin_flag engine off
</IfModule>
<FilesMatch "\.(php|phtml|phar)$">
</FilesMatch>

# Security headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "same-origin"
</IfModule>

# Force HTTPS in production (uncomment on cPanel once SSL is active)
# <IfModule mod_rewrite.c>
#     RewriteCond %{HTTPS} off
#     RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
# </IfModule>
